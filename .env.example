# Supabase — get these from your project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — used by the Vercel serverless function only
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — Google PageSpeed Insights key for the rubric audit's speed/accessibility checks.
# Works without one at low volume; add a key if audits hit rate limits.
PAGESPEED_API_KEY=
